# =============================================================
# R2DN — BACKEND
# Copiar para .env e preencher com os valores do ambiente.
# O arquivo .env NUNCA deve ser commitado no Git.
# Este .env.example contém apenas PLACEHOLDERS — sem segredos reais.
# =============================================================

# Ambiente (development | production | test)
NODE_ENV=development

# Servidor
PORT=3002
LOG_LEVEL=debug

# =============================================================
# Banco de Dados PostgreSQL — R2DN
# =============================================================
DB_HOST=192.168.0.40
DB_PORT=5432
DB_NAME=R2DN
DB_USER=seu_usuario_do_banco
DB_PASSWORD=sua_senha_do_banco
DB_SSL=false
DB_POOL_MAX=10

# Banco de dados para testes (isolado — nunca o banco de dev/prod)
TEST_DB_NAME=R2DN_test

# =============================================================
# JWT — Autenticação
# Gerar cada segredo com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================
JWT_SECRET=troque_por_um_segredo_aleatorio_de_64_bytes
JWT_REFRESH_SECRET=troque_por_outro_segredo_aleatorio_de_64_bytes
JWT_EXPIRACAO=2d
JWT_REFRESH_EXPIRACAO=2d

# =============================================================
# CORS — URL do frontend autorizada a acessar a API
# =============================================================
FRONTEND_URL=http://localhost:3000

# =============================================================
# Senha do primeiro administrador (usada apenas no seed inicial)
# =============================================================
ADMIN_EMAIL=financeiro@rngerenciadora.com.br
ADMIN_SENHA=ALTERAR_ANTES_DE_USAR

# =============================================================
# Importação do backup Firebase (script import:json)
# =============================================================
IMPORT_JSON_PATH=../backup_firebase_completo_2026-07-17.json
IMPORT_DEFAULT_PASSWORD=Mudar@123
